{
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \".claude/hooks/worktree-create.mjs\"",
            "timeout": 600
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \".claude/hooks/worktree-remove.mjs\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
