# ── Avery agent service · deploy env — TEMPLATE (committed, NO secrets) ───────────────────────────
# feat-018 (ADR-0021 §5) dual host. ONE image (eval-harness/Dockerfile), TWO targets, env-switched.
# Real keys live ONLY in the host's secret store / a gitignored eval-harness/.env — NEVER in git,
# NEVER in an image layer, NEVER toward the frontend (the frontend only ever sees SSE events).
#
# The service reads eval-harness/.env at import (avery.env.load_dotenv) AND real shell/host env wins.
# So in production you inject these via the host's env, not a committed file.
#
# ══ 1. BRAIN (pluggable — feat-015 service/brain_factory.py) ══════════════════════════════════════
#   AVERY_BRAIN selects the reasoning model. Keys are read by name per brain.
#     mock      deterministic, NO key — the AFK/offline default and CI gate.
#     minimax   境内 — MiniMax-M3        (needs MINIMAX_API_KEY)
#     deepseek  境内 — DeepSeek          (needs DEEPSEEK_API_KEY)
#     claude    海外 — claude-opus-4-8   (needs ANTHROPIC_API_KEY)
#     openai-compat  any OpenAI-compatible endpoint, fully env-driven
AVERY_BRAIN=mock

# 境内 (domestic) brain keys/endpoints — fill ONE family in the 境内 host's secret store.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 海外 (overseas) brain key — fill in the overseas host's secret store.
ANTHROPIC_API_KEY=

# openai-compat escape hatch (only if AVERY_BRAIN=openai-compat):
# AVERY_OPENAI_KEY_ENV=OPENAI_API_KEY
# AVERY_OPENAI_BASE_URL=
# AVERY_OPENAI_MODEL=

# ══ 1b. EXTRACTION (pluggable — feat-023 service/extractor_factory.py, ADR-0022 §2) ═══════════════
#   AVERY_EXTRACTOR selects the /ingest extraction engine:
#     auto       (default) LLMExtractor when an extraction key exists, else heuristic
#     llm        LLMExtractor (still degrades to heuristic when keyless/failing)
#     heuristic  forced offline regexes — the AFK/CI gate pin
#   AVERY_EXTRACTOR_BRAIN  minimax (default when keyed) | deepseek — reality is M3+DeepSeek only;
#                          brain_factory's `claude` is an unkeyed code path, never assumed here.
#   AVERY_EXTRACT_TIMEOUT_S  per-window hard timeout (default 240) — a stalled provider degrades
#                            to the heuristic instead of hanging the upload.
#   AVERY_INGEST_CONCURRENCY  (feat-027) how many documents extract in parallel per upload
#                            (default 4). Extraction fans out one blocking brain call per doc across
#                            a bounded thread pool, so a 10-file upload runs in ~max(one file) not
#                            ~sum. The cap is the rate-limit guardrail (a bursty fan-out tripped M3
#                            429s); set 1 to force the old sequential path.
AVERY_EXTRACTOR=auto

# ══ 2. RETRIEVAL + EMBEDDINGS (pluggable — feat-016 avery/ingest/store.py) ═════════════════════════
# The ingestion RAG is pluggable: keyword (offline/deterministic, the default + AFK gate) or vector
# (real embeddings + pgvector). Lite ships fine on keyword; vector is the production-quality path.
#   AVERY_RETRIEVAL   keyword (default) | vector
#   AVERY_EMBEDDINGS  which embedder when vector: 境内 bge-m3/minimax · 海外 openai/voyage
#                     (hashing = deterministic offline stand-in; exercises the vector path with no key)
# NOTE: as of feat-018 these two are wired in CODE (build_store / Embedder), not yet read from env by
# the pipeline. They are declared here as the agreed matrix; the env-read is the small follow-up when
# a real embedder is turned on (Danny picks the family — see runbook §D "vector RAG turn-on").
AVERY_RETRIEVAL=keyword
AVERY_EMBEDDINGS=hashing

# 境内 embeddings (when AVERY_EMBEDDINGS is a hosted domestic model):
# BGE_API_KEY=
# BGE_BASE_URL=
# 海外 embeddings (when AVERY_EMBEDDINGS=openai|voyage):
# OPENAI_API_KEY=
# VOYAGE_API_KEY=

# ══ 3. VECTOR STORE (pgvector — feat-016 default persistence) ═════════════════════════════════════
# pgvector is self-hostable on BOTH hosts (avoids 境内-unstable managed services — ADR-0021 §取舍).
# In-memory cosine is the offline default; set this to point the VectorStore at a real Postgres.
#   Wired in code as the persistence target; the env-read pairs with the vector turn-on above.
# PGVECTOR_URL=postgresql://avery:CHANGEME@localhost:5432/avery   # host secret store, NEVER committed

# ══ 4. SERVICE RUNTIME ════════════════════════════════════════════════════════════════════════════
PORT=8137
# CORS: the deployed frontend origins that may call this service (browser fetch). Comma-separated.
# Wire this when you enable CORS middleware for cross-origin (frontend host != service host).
# AVERY_CORS_ORIGINS=https://avery.example.com,https://avery.example.cn
