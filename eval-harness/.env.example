# ── Avery eval-harness · real-run config (MiniMax, OpenAI-compatible) ─────────────────
# This is the TEMPLATE (committed, no secrets). The real file is `.env` (gitignored).
# A blank `.env` has already been created for you — just open it and paste your key.
#
#   1) open  eval-harness/.env
#   2) paste your MiniMax key right after  MINIMAX_API_KEY=   (no quotes, no spaces)
#   3) save. Done. Any `--real` run picks it up automatically.
#
# Get a key:  https://platform.minimaxi.com
# API docs:   https://platform.minimaxi.com/docs/api-reference/text-openai-api

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3

# DeepSeek — the independent 2nd judge family (OpenAI-compatible). Get a key:
# https://platform.deepseek.com  ·  docs: https://api-docs.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Judges must be NON-Claude (self-preference bias). Two families = cross-family. DeepSeek is
# independent of the MiniMax model under test; MiniMax is a flagged secondary. NEVER Claude.
JUDGE_FAMILIES=deepseek:deepseek-v4-flash,minimax:MiniMax-M3

# ── Real vector RAG · Alibaba Bailian (百炼 / DashScope) ───────────────────────────────
# Makes the advisor's recall() semantic (embedding cosine) instead of keyword. Leave
# AVERY_EMBEDDINGS unset or =keyword for the offline default (no key, nothing breaks).
# Model choice: text-embedding-v4 — pure text, 1024-dim (env-tunable 64..2048), 100+ langs
# (one index for 境内 ZH + 海外 EN). Rerank (qwen3-rerank) is a later add, not needed yet.
# Get a key: https://bailian.console.aliyun.com  ·  OpenAI-compatible /embeddings endpoint.
AVERY_EMBEDDINGS=keyword
DASHSCOPE_API_KEY=
AVERY_EMBED_MODEL=text-embedding-v4
AVERY_EMBED_DIM=1024
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   # intl: dashscope-intl.*
